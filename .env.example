# NiFi Connection Settings
NIFI_HOST=localhost
NIFI_PORT=8080
NIFI_PROTOCOL=https
NIFI_AUTH_TYPE=none
NIFI_USERNAME=
NIFI_PASSWORD=
NIFI_VERIFY_SSL=false

# Databricks LLM Settings
# Get your token from: Databricks UI → User Settings → Developer → Access Tokens
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi1234567890abcdef...
DATABRICKS_MODEL_NAME=databricks-meta-llama-3-1-70b-instruct

# Alternative Databricks models:
# DATABRICKS_MODEL_NAME=databricks-meta-llama-3-1-405b-instruct
# DATABRICKS_MODEL_NAME=databricks-dbrx-instruct
# DATABRICKS_MODEL_NAME=databricks-mixtral-8x7b-instruct

# For custom model serving endpoints:
# DATABRICKS_ENDPOINT_NAME=your-custom-endpoint
